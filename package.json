{
  "name": "starboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "db:migrate": "wrangler d1 migrations apply starboard --local",
    "deploy": "npm run build && wrangler deploy",
    "data:refresh": "python3 collect_data.py --refresh"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "wrangler": "^4.131.1"
  }
}
